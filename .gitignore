# Private provenance / internal inputs — never publish
tools/_private/
datasets/**/_provenance.private.csv

# Python
__pycache__/
*.pyc

# OS
.DS_Store

# Solver runtime logs (e.g. VROOM access.log written into the mounted conf dir)
*.log
# VROOM dumps each solved request as <ts>_<uuid>.json into the mounted conf dir — runtime junk
solvers/vroom/conf/*.json

# Local run outputs. Competitors are regenerated by reproducers, so they stay local;
# only Routific's raw results are published (its engine isn't runnable from this repo).
# The routific-ls / routific-ga components + the best-of step are internal, not published.
results/*
!results/routific/
