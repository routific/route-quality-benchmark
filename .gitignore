# Private provenance / internal inputs — never publish.
# Default-deny everything under tools/ (internal exporters, provenance .ids/.tsv, cluster
# infra) — re-include only the genuinely-public tools by name. This stays safe even if the
# internal repo's tooling (which no longer lives under tools/_private/) reaches this tree.
tools/*
!tools/vrp_classify.py
datasets/**/_provenance.private.csv

# Python
__pycache__/
*.pyc

# OS
.DS_Store

# Solver runtime logs (e.g. VROOM access.log written into the mounted conf dir)
*.log
# VROOM dumps each solved request as <ts>_<uuid>.json into the mounted conf dir — runtime junk
solvers/vroom/conf/*.json

results/*
!results/routific/
!results/vroom/
!results/ortools/
!results/pyvrp/
!results/jsprit/
!results/all-results.md!results/competitor-budgets.tsv
