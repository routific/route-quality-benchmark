# Private provenance / internal inputs — never publish
tools/_private/
datasets/**/_provenance.private.csv

# Python
__pycache__/
*.pyc

# OS
.DS_Store

# Solver runtime logs (e.g. VROOM access.log written into the mounted conf dir)
*.log
# VROOM dumps each solved request as <ts>_<uuid>.json into the mounted conf dir — runtime junk
solvers/vroom/conf/*.json

# Local run outputs. We publish every solver's raw result files (the four competitors +
# Routific's best-of) so anyone can reproduce the comparison via analysis/analyze.py without
# re-solving. Kept local: the routific-ls / routific-ga components that feed the "routific/"
# best-of, and the generated _analysis/ tables (regenerated by analyze.py).
results/routific-ls/
results/routific-ga/
results/_analysis/
